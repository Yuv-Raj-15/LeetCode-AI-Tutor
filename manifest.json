{
  "manifest_version": 3,
  "name": "LeetCode AI Tutor",
  "version": "1.0.0",
  "author": "Yuvraj Rauniyar",
  "description": "An AI-powered tutor providing inline C++ hints and minimal code fixes on LeetCode.",
  
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "action": {
    "default_popup": "index.html",
    "default_icon": "icon48.png"
  },
  
  "permissions": [
    "activeTab",
    "scripting"
  ],
  
  "host_permissions": [
    "https://leetcode.com/*",
    "https://openrouter.ai/*"
  ]
}